name: Apex-resultaten ophalen

# Downloads new/revised result PDFs from apex-timing.com (see
# scripts/fetch_apex.py and data/apex/sources.json) and commits them, so the
# app can import them automatically.
on:
  schedule:
    - cron: "*/10 * * * *"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: fetch-results
  cancel-in-progress: false

jobs:
  fetch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Resultaten downloaden
        run: python3 scripts/fetch_apex.py

      - name: Wijzigingen committen
        run: |
          git add data/apex
          if git diff --cached --quiet; then
            echo "Geen nieuwe resultaten."
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "41898283+github-actions[bot]@users.noreply.github.com"
          git commit -m "Apex-resultaten bijgewerkt"
          git push
